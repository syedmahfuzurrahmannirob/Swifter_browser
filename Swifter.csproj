<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Swifter</RootNamespace>
    <AssemblyName>Swifter</AssemblyName>
    <Product>Swifter Browser</Product>
    <Company>Swifter</Company>
    <Copyright>Copyright © Swifter 2026</Copyright>
    <Description>Swifter - a fast, privacy-first Windows web browser with an IDM-grade segmented download engine, media sniffer, shields, and custom swifter:// pages.</Description>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- Keep the build surface clean: the compiler still reports every CS warning;
         only the Roslyn CA analyser pack is switched off for this WinForms app. -->
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.20" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\logo.png" LogicalName="Swifter.Assets.logo.png" />
    <EmbeddedResource Include="Assets\app.ico" LogicalName="Swifter.Assets.app.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Assets\logo.png" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Assets\app.ico" CopyToOutputDirectory="PreserveNewest" />
    <None Include="build-exe.ps1" CopyToOutputDirectory="Never" />
  </ItemGroup>

</Project>
